# Copy to .env (excluded from version control) and fill in.
# This file declares the NAME of every value the automations read.
# It must never hold a real one.

# --- Jenkins controller ----------------------------------------------------
# Base URL, no trailing slash. Example: https://jenkins.example.com
JENKINS_URL=
# Controller user name.
JENKINS_USER=
# API token from /me/configure > API Token > Add new Token. NOT the password:
# a token can be revoked on its own and carries no interactive session.
JENKINS_API_TOKEN=

# --- Jira (read only) ------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
