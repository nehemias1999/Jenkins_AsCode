# Local environment files. Never commit a real secret value.
.env
.env.*
!.env.example

# Workstation scratch space: drafts, exports, credential files handed over out of band.
.local/

# Reproducible run outputs (inventories, plans, reports, receipts, logs).
artifacts/

# Active configuration created by renaming a versioned template.
automations/*/config/jobs.json
automations/*/config/pipelines.json
automations/*/config/issues.json

# Misc
*.log
*.tmp
*.bak
